# clang configuration for the @PROFILE@ toolchain profile of mpv-winbuild.
# Options prefixed with $ are used only when linking and are placed after the
# linker inputs.

--target=x86_64-w64-mingw32
--sysroot=@SYSROOT_DIR@
-resource-dir=@RESOURCE_DIR@
-rtlib=compiler-rt
-unwindlib=libunwind
-stdlib=libc++
-fuse-ld=lld

@CPU_FLAGS@
-mguard=cf
-ffunction-sections
-fdata-sections

$-static
$-Wl,--lto-O3
$-Wl,--gc-sections
$-Wl,--icf=safe
$-Wl,-Xlink=-release
$-Wl,--thinlto-cache-dir=@THINLTO_CACHE_DIR@
$-Wl,--thinlto-cache-policy=cache_size_bytes=1g:prune_interval=1m
