# CMake toolchain file for the @PROFILE@ toolchain profile of mpv-winbuild.

set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)

set(CMAKE_C_COMPILER "@BIN_DIR@/x86_64-w64-mingw32-clang")
set(CMAKE_CXX_COMPILER "@BIN_DIR@/x86_64-w64-mingw32-clang++")
set(CMAKE_RC_COMPILER "@BIN_DIR@/x86_64-w64-mingw32-windres")

# No package uses C++ modules, and clang-scan-deps would not see the options
# the compiler wrapper adds.
set(CMAKE_CXX_SCAN_FOR_MODULES OFF)

set(CMAKE_FIND_ROOT_PATH "@SYSROOT_DIR@")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

set(PKG_CONFIG_EXECUTABLE "@BIN_DIR@/x86_64-w64-mingw32-pkg-config")
