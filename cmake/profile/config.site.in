# Autoconf site defaults of the @PROFILE@ toolchain profile, read by configure
# scripts run through the exec wrapper. Arguments of a recipe take
# precedence.

# Absolute paths, since llvm-windres finds its preprocessor next to the path it
# was started from.
: "${CC=@TOOLCHAIN_BIN_DIR@/@TARGET_TRIPLE@-clang}"
: "${CXX=@TOOLCHAIN_BIN_DIR@/@TARGET_TRIPLE@-clang++}"
: "${RC=@TOOLCHAIN_BIN_DIR@/@TARGET_TRIPLE@-windres}"
: "${WINDRES=@TOOLCHAIN_BIN_DIR@/@TARGET_TRIPLE@-windres}"
