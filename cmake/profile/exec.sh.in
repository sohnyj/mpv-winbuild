#!/bin/sh
# Runs a command with the @PROFILE@ toolchain profile: its tools and Rust first
# in PATH, its autoconf site file, and the cargo linkers for the target and the
# build machine.
RUSTUP_HOME="@RUSTUP_DIR@/.rustup"
CARGO_HOME="@RUSTUP_DIR@/.cargo"
PATH="@BIN_DIR@:${CARGO_HOME}/bin:$PATH"
CONFIG_SITE="@CONFIG_SITE@"
CARGO_TARGET_@RUST_TARGET_IDENTIFIER@_LINKER="@BIN_DIR@/@TARGET_TRIPLE@-clang++"
CARGO_TARGET_@RUST_TARGET_IDENTIFIER@_AR="@BIN_DIR@/@TARGET_TRIPLE@-ar"
CARGO_TARGET_@RUST_HOST_IDENTIFIER@_LINKER="@HOST_C_COMPILER@"
export RUSTUP_HOME CARGO_HOME PATH CONFIG_SITE
export CARGO_TARGET_@RUST_TARGET_IDENTIFIER@_LINKER CARGO_TARGET_@RUST_TARGET_IDENTIFIER@_AR
export CARGO_TARGET_@RUST_HOST_IDENTIFIER@_LINKER
exec "$@"
