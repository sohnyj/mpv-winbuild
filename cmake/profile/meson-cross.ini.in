# Meson cross file for the @PROFILE@ toolchain profile of mpv-winbuild.

[binaries]
c = '@BIN_DIR@/@TARGET_TRIPLE@-clang'
cpp = '@BIN_DIR@/@TARGET_TRIPLE@-clang++'
ar = '@BIN_DIR@/@TARGET_TRIPLE@-ar'
strip = '@BIN_DIR@/@TARGET_TRIPLE@-strip'
windres = '@BIN_DIR@/@TARGET_TRIPLE@-windres'
dlltool = '@BIN_DIR@/@TARGET_TRIPLE@-dlltool'
pkg-config = '@BIN_DIR@/@TARGET_TRIPLE@-pkg-config'
nasm = '@NASM_EXECUTABLE@'

[host_machine]
system = 'windows'
cpu_family = '@TARGET_PROCESSOR@'
cpu = '@TARGET_PROCESSOR@'
endian = 'little'
